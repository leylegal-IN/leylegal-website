# Copy to .env.local for local testing. On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string. Vercel adds this for you when you connect a database in the project's
# Storage tab (Neon or Supabase). For local testing against the throwaway database from `npm run dev:db`:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/postgres

# Password for downloading the waitlist as a spreadsheet at /api/waitlist-export
# (the browser asks for a username and password: any username, this password). Use a long random one.
WAITLIST_EXPORT_PASSWORD=change-me
